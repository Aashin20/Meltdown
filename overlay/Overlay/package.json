{
  "name": "overlay",
  "version": "0.0.0",
  "description": "Windows desktop voice assistant overlay",
  "author": "Meltdown",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "electron": "electron .",
    "desktop:dev": "run-p dev desktop:electron",
    "desktop:electron": "node desktop/start-dev.cjs",
    "build": "vite build",
    "desktop:build": "npm run build && node desktop/package.cjs",
    "preview": "vite preview",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-vue": "~10.11.0",
    "globals": "^17.12.0",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.82.0",
    "prettier": "3.9.6",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-eslint-parser": "^10.4.1",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.meltdown.voiceorb",
    "productName": "Meltdown Voice Orb",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
